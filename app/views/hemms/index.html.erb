<% content_for :title, "HEMMs" %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

  <!-- Flash Notice -->
  <% if notice.present? %>
    <div class="mb-6 rounded-md bg-green-50 p-4 border border-green-200 shadow-sm" id="notice">
      <div class="flex">
        <div class="flex-shrink-0">
          <svg class="h-5 w-5 text-green-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
          </svg>
        </div>
        <div class="ml-3">
          <p class="text-sm font-medium text-green-800"><%= notice %></p>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Header Section -->
  <div class="sm:flex sm:items-center sm:justify-between mb-8">
    <div>
      <h1 class="text-3xl font-bold text-gray-900">HEMM Fleet</h1>
      <p class="mt-2 text-sm text-gray-700">Manage all dumpers, excavators, and heavy machinery in your system.</p>
    </div>
    <div class="mt-4 sm:mt-0">
      <%= link_to "New HEMM", new_hemm_path, class: "inline-flex items-center justify-center rounded-md border border-transparent bg-blue-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition-colors" %>
    </div>
  </div>

  <!-- Table Container -->
  <div class="bg-white shadow-sm ring-1 ring-black ring-opacity-5 md:rounded-lg overflow-hidden">
    <% if @hemms.any? %>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-300">
          <thead class="bg-gray-50">
          <tr>
            <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 sm:pl-6">SL No</th>
            <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Equipment Details</th>
            <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Capacity</th>
            <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Status</th>
            <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Tyres</th>
            <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-6 text-right text-sm font-semibold text-gray-900">Actions</th>
          </tr>
          </thead>
          <tbody class="divide-y divide-gray-200 bg-white">
          <% @hemms.each do |hemm| %>
            <tr class="hover:bg-gray-50 transition-colors">

              <!-- SL NO Column -->
              <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-gray-900 sm:pl-6">
                <%= hemm.slno %>
              </td>

              <!-- Make & Model Column (Stacked layout for clean data) -->
              <td class="whitespace-nowrap px-3 py-4 text-sm">
                <div class="font-medium text-gray-900"><%= hemm.try(:model) || "Model N/A" %></div>
                <div class="text-gray-500"><%= hemm.try(:make) || "Make N/A" %></div>
              </td>

              <!-- Capacity Column -->
              <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                <% if hemm.try(:capacity).present? %>
                  <span class="font-medium text-gray-900"><%= hemm.capacity %></span> Tonnes
                <% else %>
                  <span class="text-gray-400">-</span>
                <% end %>
              </td>

              <!-- Status Badge Column -->
              <td class="whitespace-nowrap px-3 py-4 text-sm">
                <% if hemm.try(:active?) %>
                  <span class="inline-flex items-center rounded-full bg-green-50 px-2 py-1 text-xs font-medium text-green-700 ring-1 ring-inset ring-green-600/20">Operational</span>
                <% else %>
                  <span class="inline-flex items-center rounded-full bg-yellow-50 px-2 py-1 text-xs font-medium text-yellow-800 ring-1 ring-inset ring-yellow-600/20">Under Maintenance</span>
                <% end %>
              </td>

              <!-- Tyres Link -->
              <td class="whitespace-nowrap px-3 py-4 text-sm">
                <%= link_to hemm_tyres_path(hemm), class: "inline-flex items-center text-blue-600 hover:text-blue-900 font-medium group" do %>
                  <svg class="mr-1.5 h-4 w-4 text-blue-500 group-hover:text-blue-700" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 9.75l4.5 4.5m0-4.5l-4.5 4.5M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  Manage
                <% end %>
              </td>

              <!-- Actions Column -->
              <td class="relative whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:pr-6">
                <div class="flex items-center justify-end gap-3">
                  <%= link_to "View", hemm, class: "text-blue-600 hover:text-blue-900" %>
                  <%= link_to "Edit", edit_hemm_path(hemm), class: "text-indigo-600 hover:text-indigo-900" %>
                  <%= button_to "Delete", hemm, method: :delete, data: { turbo_confirm: "Are you sure you want to delete this HEMM?" }, class: "text-red-600 hover:text-red-900 bg-transparent border-none p-0 cursor-pointer" %>
                </div>
              </td>

            </tr>
          <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <!-- Empty State -->
      <div class="text-center p-12 bg-gray-50">
        <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 002-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
        </svg>
        <h3 class="mt-2 text-sm font-semibold text-gray-900">No HEMMs found</h3>
        <p class="mt-1 text-sm text-gray-500">Get started by adding your first machine to the fleet.</p>
        <div class="mt-6">
          <%= link_to "New HEMM", new_hemm_path, class: "inline-flex items-center rounded-md bg-blue-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 transition-colors" %>
        </div>
      </div>
    <% end %>
  </div>
</div>