<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <!-- Header Section -->
  <div class="sm:flex sm:items-center sm:justify-between mb-8">
    <div>
      <h1 class="text-3xl font-bold text-gray-900">
        Tyres - <%= @hemm.slno %>
      </h1>
      <p class="mt-2 text-sm text-gray-700">Manage and monitor tyre pressures, temperatures, and sensor statuses.</p>
    </div>
    <div class="mt-4 sm:mt-0">
      <%= link_to "Add Tyre",
                  new_hemm_tyre_path(@hemm),
                  class: "inline-flex items-center justify-center rounded-md border border-transparent bg-blue-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition-colors" %>
    </div>
  </div>

  <% if @tyres.any? %>
    <!-- Table Section -->
    <div class="bg-white shadow-sm ring-1 ring-black ring-opacity-5 md:rounded-lg overflow-hidden">
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-300">
          <thead class="bg-gray-50">
          <tr>
            <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 sm:pl-6">Position</th>
            <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Pressure</th>
            <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Temp</th>
            <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Sensor ID</th>
            <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Status</th>
            <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-6 text-right text-sm font-semibold text-gray-900">Actions</th>
          </tr>
          </thead>
          <tbody class="divide-y divide-gray-200 bg-white">
          <% @tyres.each do |tyre| %>
            <tr class="hover:bg-gray-50 transition-colors">
              <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-gray-900 sm:pl-6">
                <%= tyre.position %>
              </td>
              <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                <% if tyre.pressure.present? %>
                  <span class="font-medium text-gray-900"><%= tyre.pressure %></span> PSI
                <% else %>
                  <span class="text-gray-400">-</span>
                <% end %>
              </td>
              <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                <% if tyre.temp.present? %>
                  <span class="font-medium text-gray-900"><%= tyre.temp %></span> &deg;C
                <% else %>
                  <span class="text-gray-400">-</span>
                <% end %>
              </td>
              <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                <%= tyre.sensor_id.presence || "<span class='text-gray-400'>-</span>".html_safe %>
              </td>
              <td class="whitespace-nowrap px-3 py-4 text-sm">
                <% if tyre.active? %>
                  <span class="inline-flex items-center rounded-full bg-green-50 px-2 py-1 text-xs font-medium text-green-700 ring-1 ring-inset ring-green-600/20">Active</span>
                <% else %>
                  <span class="inline-flex items-center rounded-full bg-red-50 px-2 py-1 text-xs font-medium text-red-700 ring-1 ring-inset ring-red-600/10">Inactive</span>
                <% end %>
              </td>
              <td class="relative whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:pr-6">
                <div class="flex items-center justify-end gap-3">
                  <%= link_to "View",
                              hemm_tyre_path(@hemm, tyre),
                              class: "text-blue-600 hover:text-blue-900" %>

                  <%= link_to "Edit",
                              edit_hemm_tyre_path(@hemm, tyre),
                              class: "text-indigo-600 hover:text-indigo-900" %>

                  <%= button_to "Delete",
                                hemm_tyre_path(@hemm, tyre),
                                method: :delete,
                                data: { turbo_confirm: "Are you sure you want to delete this tyre?" },
                                class: "text-red-600 hover:text-red-900 bg-transparent border-none p-0 cursor-pointer" %>
                </div>
              </td>
            </tr>
          <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% else %>
    <!-- Empty State Section -->
    <div class="text-center rounded-lg border-2 border-dashed border-gray-300 p-12 bg-gray-50">
      <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
      </svg>
      <h3 class="mt-2 text-sm font-semibold text-gray-900">No tyres mounted</h3>
      <p class="mt-1 text-sm text-gray-500">No tyres are currently mounted on this HEMM.</p>
      <div class="mt-6">
        <%= link_to "Add the first tyre",
                    new_hemm_tyre_path(@hemm),
                    class: "inline-flex items-center rounded-md bg-blue-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 transition-colors" %>
      </div>
    </div>
  <% end %>

  <!-- Footer Link -->
  <div class="mt-6">
    <%= link_to hemm_path(@hemm), class: "inline-flex items-center text-sm font-medium text-gray-600 hover:text-gray-900 transition-colors" do %>
      <svg class="mr-1 h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M17 10a.75.75 0 01-.75.75H5.612l4.158 3.96a.75.75 0 11-1.04 1.08l-5.5-5.25a.75.75 0 010-1.08l5.5-5.25a.75.75 0 111.04 1.08L5.612 9.25H16.25A.75.75 0 0117 10z" clip-rule="evenodd" />
      </svg>
      Back to HEMM
    <% end %>
  </div>
</div>