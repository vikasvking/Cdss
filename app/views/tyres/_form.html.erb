<%= form_with(model: [@hemm, @tyre], class: "space-y-6") do |form| %>

  <% if @tyre.errors.any? %>
    <div class="rounded-lg border border-red-200 bg-red-50 p-4 text-red-700">
      <h2 class="font-semibold">
        <%= pluralize(@tyre.errors.count, "error") %>
        prevented this tyre from being saved:
      </h2>

      <ul class="mt-2 list-disc pl-5 text-sm">
        <% @tyre.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- Tyre Position -->
  <div>
    <%= form.label :position,
                   "Tyre Position",
                   class: "mb-2 block text-sm font-medium text-gray-700" %>

    <%= form.select :position,
                    Tyre::POSITIONS.map { |position| [position, position] },
                    { prompt: "Select tyre position" },
                    class: "block w-full rounded-lg border border-gray-300 bg-white px-3 py-2.5 text-sm text-gray-900 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
  </div>

  <!-- Pressure -->
  <div>
    <%= form.label :pressure,
                   "Pressure (PSI)",
                   class: "mb-2 block text-sm font-medium text-gray-700" %>

    <%= form.number_field :pressure,
                          step: 0.1,
                          min: 0,
                          max: 150,
                          placeholder: "e.g. 82.5",
                          class: "block w-full rounded-lg border border-gray-300 bg-white px-3 py-2.5 text-sm text-gray-900 shadow-sm placeholder:text-gray-400 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
  </div>

  <div>
    <%= form.label :temp,
                   "Temperature",
                   class: "mb-2 block text-sm font-medium text-gray-700" %>

    <%= form.number_field :temp,
                          step: 0.1,
                          min: 0,
                          max: 150,
                          placeholder: "e.g. 22.5",
                          class: "block w-full rounded-lg border border-gray-300 bg-white px-3 py-2.5 text-sm text-gray-900 shadow-sm placeholder:text-gray-400 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
  </div>

  <!-- TPMS Sensor ID -->
  <div>
    <%= form.label :sensor_id,
                   "TPMS Sensor ID",
                   class: "mb-2 block text-sm font-medium text-gray-700" %>

    <%= form.text_field :sensor_id,
                        placeholder: "e.g. TPMS001",
                        class: "block w-full rounded-lg border border-gray-300 bg-white px-3 py-2.5 text-sm text-gray-900 shadow-sm placeholder:text-gray-400 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
  </div>

  <!-- Active -->
  <div class="flex items-center gap-3">
    <%= form.check_box :active,
                       class: "h-4 w-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500" %>

    <%= form.label :active,
                   "Active",
                   class: "text-sm font-medium text-gray-700" %>
  </div>

  <!-- Submit -->
  <div>
    <%= form.submit "Create Tyre",
                    class: "inline-flex cursor-pointer items-center rounded-lg bg-blue-600 px-5 py-2.5 text-sm font-medium text-white shadow-sm transition hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2" %>
  </div>

<% end %>